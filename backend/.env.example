# Database (Railway provides this automatically when you add PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# CORS Origins (your Vercel frontend URL)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Frontend URL for email links
FRONTEND_URL=https://your-app.vercel.app

# Optional: Stripe (for future subscription features)
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (for email verification) - Get API key from https://resend.com
RESEND_API_KEY=re_xxx
FROM_EMAIL=Foood <noreply@yourdomain.com>

# Verification settings (optional, defaults shown)
# VERIFICATION_CODE_EXPIRY_MINUTES=15
# MAX_VERIFICATION_ATTEMPTS=5
# MAX_RESEND_PER_HOUR=3
